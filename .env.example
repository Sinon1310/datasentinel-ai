# Copy to .env and adjust. Never commit .env.

DATASENTINEL_LOG_LEVEL=INFO
DATASENTINEL_MAX_UPLOAD_SIZE_MB=200
DATASENTINEL_DATA_DIR=.datasentinel

# AI investigation (Milestone 2). Required to run agents; the deterministic dashboard works without it.
GROQ_API_KEY=
# Groq model; must support tool calling. Verified: openai/gpt-oss-120b (default), openai/gpt-oss-20b.
# (The legacy name DATASENTINEL_GROQ_MODEL is still accepted; GROQ_MODEL wins if both are set.)
GROQ_MODEL=openai/gpt-oss-120b

# Optional agent limits (defaults shown)
# DATASENTINEL_AGENT_MAX_TOOL_CALLS=8
# DATASENTINEL_AGENT_MAX_REPAIR_ATTEMPTS=2
# DATASENTINEL_AGENT_LLM_RETRY_ATTEMPTS=3
# DATASENTINEL_AGENT_DRY_RUN_ROWS=5000
